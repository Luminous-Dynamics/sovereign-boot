  "principles": [
    "measure actual presentation, not render submission",
    "compare matched feature intersections and identical assets",
    "report marginal energy against same-host idle",
    "keep CPU, GPU, video decode, display and package power domains separate",
    "publish raw trials and preserve unsupported cells",
    "publish Pareto frontiers rather than one weighted score"
  ],
