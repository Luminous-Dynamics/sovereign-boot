  "experimentalMethod": {
    "warmupSeconds": 300,
    "measuredSeconds": 900,
    "pairedTrialsMinimum": 10,
    "ordering": "randomized ABBA or randomized paired blocks",
    "idleBaseline": "same host immediately before and after each active run",
    "rawSampleIntervalHz": 10,
    "preserveEveryTrial": true,
    "statistics": [
      "median",
      "p50",
      "p95",
      "p99",
      "p99.9",
      "95% confidence interval"
    ],
    "power": "external wall meter for total system; RAPL/turbostat and vendor GPU counters only for documented non-overlapping domains",
    "presentation": "compositor feedback where available; render-submit is never equivalent to presented",
    "blindedPerception": "pre-registered, separate measures for recognition, motion continuity, preference, distraction and comfort"
  },
  "metrics": {
    "marginalEnergyJ": "Integral(active system power - paired idle baseline power) over the measured interval, with uncertainty propagated from meter resolution and baseline drift.",
    "joulesPerPresentedFrame": "Marginal energy divided by actual compositor-presented frame count; do not divide by submitted or rendered frames.",
    "discardedRatio": "Compositor-discarded updates / terminal feedback outcomes; report Unknown separately.",
    "presentationInterval": "Difference between consecutive compositor presentation timestamps in the same clock domain and output; do not mix outputs or clock IDs.",
    "energyDomains": "Report each measured physical domain and its documented boundaries; do not sum overlapping package/GPU counters."
  },
  "trustLabels": [
    "measured_external",
    "measured_host",
    "compositor_reported",
    "renderer_reported",
    "estimated",
    "unknown",
    "unsupported"
  ],
  "unsupportedPolicy": "Emit an explicit unsupported result with a reason; do not replace a missing capability with a different workload.",
  "nonClaims": [
    "no comparative runs performed",
    "no competitor superiority or inferiority established",
    "all referenced competitor feature claims require version pinning at test time"
  ]
