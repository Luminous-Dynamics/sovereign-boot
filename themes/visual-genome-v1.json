    "boot": "cpu-reference-only",
    "desktop": "wgpu-vulkan-preferred",
    "lockscreen": "desktop-background-adapter-only",
    "universal_fallback": "static",
    "remote_assets": false,
    "executable_theme_scripts": false,
    "network_access_from_renderer": false,
    "full_screen_flash": false
  },
